        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showUnfilled": true
      },
      "targets": [
        {
          "expr": "topk(10, sum by (osgi_operation) (osgi_demo_operations_total))",
          "legendFormat": "{{osgi_operation}}",
          "refId": "A"
        }
      ]
    },
