    {
      "type": "row",
      "title": "🔍 Recent Traces",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 46 },
      "collapsed": false
    },
    {
      "type": "table",
      "title": "Recent Traces",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 47 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
