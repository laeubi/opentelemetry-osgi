<?xml version="1.0" encoding="UTF-8"?>
<!--
    Apache Karaf feature descriptor for OpenTelemetry OSGi Integrations.

    Deploys the integration bundles that bridge OSGi subsystems to OpenTelemetry:
      - Framework bridge (bundles, services, events)
      - SCR introspection (Declarative Services component state)
      - Log bridge (OSGi Log Service forwarding)
      - Config Admin (configuration events and inventory)
      - Felix Health Check (health check results and execution)
      - MXBeans (JVM memory, CPU, threads, GC, class loading)
      - Typed Event (OSGi Typed Event Bus monitoring)
-->
<features name="opentelemetry-osgi-integrations-${project.version}"
          xmlns="http://karaf.apache.org/xmlns/features/v1.6.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://karaf.apache.org/xmlns/features/v1.6.0
                              http://karaf.apache.org/xmlns/features/v1.6.0">

    <!--
        OpenTelemetry OSGi Integrations.
        Bridges OSGi framework, SCR, Log Service, Felix Health Check, Config Admin, and Typed Event into OpenTelemetry.
        Depends on the opentelemetry-osgi feature which provides the runtime.
    -->
    <feature name="opentelemetry-osgi-integrations" version="${project.version}"
             description="OpenTelemetry OSGi Integration Bundles">
        <feature version="${project.version}">opentelemetry-osgi</feature>

        <!-- Framework: instruments bundle/service events and inventory as metrics and logs -->
        <bundle>mvn:org.eclipse.osgi-technology.incubator/opentelemetry-osgi-framework/${project.version}</bundle>
        <!-- SCR: exposes Declarative Services component state as telemetry -->
        <bundle>mvn:org.eclipse.osgi-technology.incubator/opentelemetry-osgi-scr/${project.version}</bundle>
        <!-- Log: forwards OSGi Log Service entries to OpenTelemetry logs -->
        <bundle>mvn:org.eclipse.osgi-technology.incubator/opentelemetry-osgi-log/${project.version}</bundle>
        <!-- Config Admin: tracks configuration changes as telemetry -->
        <bundle>mvn:org.eclipse.osgi-technology.incubator/opentelemetry-osgi-cm/${project.version}</bundle>

        <!-- Felix Health Check: runtime dependencies -->
        <bundle>mvn:org.apache.felix/org.apache.felix.healthcheck.api/${felix.healthcheck.api.version}</bundle>
        <bundle>mvn:org.apache.felix/org.apache.felix.healthcheck.core/${felix.healthcheck.core.version}</bundle>
        <bundle>mvn:org.apache.felix/org.apache.felix.healthcheck.generalchecks/${felix.healthcheck.generalchecks.version}</bundle>
        <!-- Health Check: exposes health check results as telemetry -->
        <bundle>mvn:org.eclipse.osgi-technology.incubator/opentelemetry-osgi-felix-healthcheck/${project.version}</bundle>

        <!-- MXBeans: exposes Java Management MXBean metrics as OpenTelemetry gauges -->
        <bundle>mvn:org.eclipse.osgi-technology.incubator/opentelemetry-osgi-mxbeans/${project.version}</bundle>

        <!-- Typed Event: runtime dependencies (Aries TypedEvent Bus + OSGi utilities) -->
        <bundle>mvn:org.osgi/org.osgi.service.typedevent/${osgi.service.typedevent.version}</bundle>
        <bundle>mvn:org.osgi/org.osgi.util.function/${osgi.util.function.version}</bundle>
        <bundle>mvn:org.osgi/org.osgi.util.promise/${osgi.util.promise.version}</bundle>
        <bundle>mvn:org.osgi/org.osgi.util.pushstream/${osgi.util.pushstream.version}</bundle>
        <bundle>mvn:org.osgi/org.osgi.util.converter/${osgi.util.converter.version}</bundle>
        <bundle>mvn:org.apache.aries.component-dsl/org.apache.aries.component-dsl.component-dsl/${aries.component.dsl.version}</bundle>
        <bundle>mvn:org.apache.aries.typedevent/org.apache.aries.typedevent.bus/${aries.typedevent.version}</bundle>
        <!-- Typed Event: monitors events and exposes as telemetry -->
        <bundle>mvn:org.eclipse.osgi-technology.incubator/opentelemetry-osgi-typedevent/${project.version}</bundle>

        <!-- Weaving Hook: OSGi-native bytecode instrumentation infrastructure (ASM embedded) -->
        <bundle start-level="20">mvn:org.eclipse.osgi-technology.incubator/opentelemetry-osgi-weaving/${project.version}</bundle>
        <!-- Servlet Weaver: fragment attaching to weaving host for HTTP servlet instrumentation -->
        <bundle start-level="20">mvn:org.eclipse.osgi-technology.incubator/opentelemetry-osgi-weaver-servlet/${project.version}</bundle>
        <!-- JDBC Weaver: fragment attaching to weaving host for JDBC instrumentation -->
        <bundle start-level="20">mvn:org.eclipse.osgi-technology.incubator/opentelemetry-osgi-weaver-jdbc/${project.version}</bundle>
        <!-- JAX-RS Weaver: fragment attaching to weaving host for JAX-RS resource instrumentation -->
        <bundle start-level="20">mvn:org.eclipse.osgi-technology.incubator/opentelemetry-osgi-weaver-jaxrs/${project.version}</bundle>
        <!-- SCR Lifecycle Weaver: fragment attaching to weaving host for DS component lifecycle instrumentation -->
        <bundle start-level="20">mvn:org.eclipse.osgi-technology.incubator/opentelemetry-osgi-weaver-scr/${project.version}</bundle>
    </feature>

</features>
