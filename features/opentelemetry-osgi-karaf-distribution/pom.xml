<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.eclipse.osgi-technology.incubator</groupId>
        <artifactId>opentelemetry-osgi-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>opentelemetry-osgi-karaf-distribution</artifactId>
    <packaging>karaf-assembly</packaging>
    <name>OpenTelemetry OSGi Karaf Distribution</name>
    <description>
        Pre-built Apache Karaf distribution with all OpenTelemetry OSGi features
        and dependencies pre-installed. Ready to run — no network access needed.
    </description>

    <properties>
        <karaf.version>4.4.7</karaf.version>
    </properties>

    <dependencies>
        <!-- Karaf framework distribution (base for the assembly) -->
        <dependency>
            <groupId>org.apache.karaf.features</groupId>
            <artifactId>framework</artifactId>
            <version>${karaf.version}</version>
            <type>kar</type>
        </dependency>
        <dependency>
            <groupId>org.apache.karaf.features</groupId>
            <artifactId>standard</artifactId>
            <version>${karaf.version}</version>
            <classifier>features</classifier>
            <type>xml</type>
        </dependency>
        <dependency>
            <groupId>org.apache.karaf.features</groupId>
            <artifactId>specs</artifactId>
            <version>${karaf.version}</version>
            <classifier>features</classifier>
            <type>xml</type>
        </dependency>

        <!-- Our feature descriptors -->
        <dependency>
            <groupId>org.eclipse.osgi-technology.incubator</groupId>
            <artifactId>opentelemetry-osgi-karaf-feature</artifactId>
            <version>${project.version}</version>
            <classifier>features</classifier>
            <type>xml</type>
        </dependency>
        <dependency>
            <groupId>org.eclipse.osgi-technology.incubator</groupId>
            <artifactId>opentelemetry-osgi-integration-karaf-feature</artifactId>
            <version>${project.version}</version>
            <classifier>features</classifier>
            <type>xml</type>
        </dependency>
        <dependency>
            <groupId>org.eclipse.osgi-technology.incubator</groupId>
            <artifactId>opentelemetry-osgi-demo-karaf-feature</artifactId>
            <version>${project.version}</version>
            <classifier>features</classifier>
            <type>xml</type>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Skip bnd — this is not an OSGi bundle -->
            <plugin>
                <groupId>biz.aQute.bnd</groupId>
                <artifactId>bnd-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>generate-osgi-metadata</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>
            <!-- Skip default jar plugin — karaf-assembly produces its own output -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-jar</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.karaf.tooling</groupId>
                <artifactId>karaf-maven-plugin</artifactId>
                <version>${karaf.version}</version>
                <extensions>true</extensions>
                <configuration>
                    <javase>21</javase>
                    <bootFeatures>
                        <feature>wrap</feature>
                        <feature>bundle</feature>
                        <feature>config</feature>
                        <feature>deployer</feature>
                        <feature>diagnostic</feature>
                        <feature>feature</feature>
                        <feature>instance</feature>
                        <feature>jaas</feature>
                        <feature>kar</feature>
                        <feature>log</feature>
                        <feature>package</feature>
                        <feature>service</feature>
                        <feature>shell</feature>
                        <feature>ssh</feature>
                        <feature>system</feature>
                        <feature>eventadmin</feature>
                        <feature>management</feature>
                        <!-- Our features -->
                        <feature>opentelemetry-osgi-demo</feature>
                    </bootFeatures>
                    <libraries>
                    </libraries>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
