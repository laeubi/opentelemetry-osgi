<?xml version="1.0" encoding="UTF-8"?>
<!--
    Apache Karaf feature descriptor for OpenTelemetry OSGi Integration.

    Features:
      opentelemetry-deps       — OpenTelemetry Java SDK wrapped as OSGi bundles
      opentelemetry-osgi       — Integration bundles (runtime, core, scr, log) + config
      opentelemetry-osgi-demo  — Adds the demo client module
-->
<features name="opentelemetry-osgi-${project.version}"
          xmlns="http://karaf.apache.org/xmlns/features/v1.6.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://karaf.apache.org/xmlns/features/v1.6.0
                              http://karaf.apache.org/xmlns/features/v1.6.0">

    <!--
        OpenTelemetry Java SDK wrapped as OSGi bundles.
        Reusable by any project that needs OTel in an OSGi container.
        Uses Karaf's wrap: protocol to add OSGi metadata to non-OSGi JARs.
    -->
    <feature name="opentelemetry-deps" version="${opentelemetry.version}"
             description="OpenTelemetry Java SDK wrapped for OSGi">

        <!-- API and Context -->
        <bundle>wrap:mvn:io.opentelemetry/opentelemetry-api/${opentelemetry.version}$Import-Package=*;resolution:=optional&amp;Export-Package=*</bundle>
        <bundle>wrap:mvn:io.opentelemetry/opentelemetry-context/${opentelemetry.version}$Import-Package=*;resolution:=optional&amp;Export-Package=*</bundle>

        <!-- SDK Core -->
        <bundle>wrap:mvn:io.opentelemetry/opentelemetry-sdk-common/${opentelemetry.version}$Import-Package=*;resolution:=optional&amp;Export-Package=*</bundle>
        <bundle>wrap:mvn:io.opentelemetry/opentelemetry-sdk/${opentelemetry.version}$Import-Package=*;resolution:=optional&amp;Export-Package=*</bundle>

        <!-- SDK Signal Providers -->
        <bundle>wrap:mvn:io.opentelemetry/opentelemetry-sdk-trace/${opentelemetry.version}$Import-Package=*;resolution:=optional&amp;Export-Package=*</bundle>
        <bundle>wrap:mvn:io.opentelemetry/opentelemetry-sdk-metrics/${opentelemetry.version}$Import-Package=*;resolution:=optional&amp;Export-Package=*</bundle>
        <bundle>wrap:mvn:io.opentelemetry/opentelemetry-sdk-logs/${opentelemetry.version}$Import-Package=*;resolution:=optional&amp;Export-Package=*</bundle>

        <!-- Exporters -->
        <bundle>wrap:mvn:io.opentelemetry/opentelemetry-exporter-common/${opentelemetry.version}$Import-Package=*;resolution:=optional&amp;Export-Package=*</bundle>
        <bundle>wrap:mvn:io.opentelemetry/opentelemetry-exporter-logging/${opentelemetry.version}$Import-Package=*;resolution:=optional&amp;Export-Package=*</bundle>
        <bundle>wrap:mvn:io.opentelemetry/opentelemetry-exporter-otlp/${opentelemetry.version}$Import-Package=*;resolution:=optional&amp;Export-Package=*</bundle>
        <bundle>wrap:mvn:io.opentelemetry/opentelemetry-exporter-otlp-common/${opentelemetry.version}$Import-Package=*;resolution:=optional&amp;Export-Package=*</bundle>
        <bundle>wrap:mvn:io.opentelemetry/opentelemetry-exporter-sender-jdk/${opentelemetry.version}$Import-Package=*;resolution:=optional&amp;Export-Package=*</bundle>

        <!-- SDK Autoconfigure -->
        <bundle>wrap:mvn:io.opentelemetry/opentelemetry-sdk-extension-autoconfigure-spi/${opentelemetry.version}$Import-Package=*;resolution:=optional&amp;Export-Package=*</bundle>
        <bundle>wrap:mvn:io.opentelemetry/opentelemetry-sdk-extension-autoconfigure/${opentelemetry.version}$Import-Package=*;resolution:=optional&amp;Export-Package=*</bundle>
    </feature>

    <!--
        OpenTelemetry OSGi Integration.
        Deploys our bridge bundles that connect the OSGi runtime with OpenTelemetry.
        Requires Karaf's scr feature for Declarative Services.
    -->
    <feature name="opentelemetry-osgi" version="${project.version}"
             description="OpenTelemetry OSGi Integration">
        <feature>scr</feature>
        <feature version="${opentelemetry.version}">opentelemetry-deps</feature>

        <!-- Runtime: creates and publishes the OpenTelemetry SDK as an OSGi service -->
        <bundle>mvn:io.opentelemetry.osgi/opentelemetry-osgi-runtime/${project.version}</bundle>
        <!-- Core: instruments framework events, bundle/service inventory as metrics and logs -->
        <bundle>mvn:io.opentelemetry.osgi/opentelemetry-osgi-core/${project.version}</bundle>
        <!-- SCR: exposes Declarative Services component state as telemetry -->
        <bundle>mvn:io.opentelemetry.osgi/opentelemetry-osgi-scr/${project.version}</bundle>
        <!-- Log: forwards OSGi Log Service entries to OpenTelemetry logs -->
        <bundle>mvn:io.opentelemetry.osgi/opentelemetry-osgi-log/${project.version}</bundle>

        <!-- Default configuration: logging exporter -->
        <config name="io.opentelemetry.osgi.runtime">
            serviceName = osgi-application
            exporterType = logging
        </config>
    </feature>

    <!--
        Demo feature: adds the client module that periodically generates
        traces, metrics, and logs for demonstration purposes.
    -->
    <feature name="opentelemetry-osgi-demo" version="${project.version}"
             description="OpenTelemetry OSGi Demo Client">
        <feature version="${project.version}">opentelemetry-osgi</feature>
        <bundle>mvn:io.opentelemetry.osgi/opentelemetry-osgi-client/${project.version}</bundle>
    </feature>

</features>
